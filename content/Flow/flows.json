            new THREE.GridHelper(\n                10,\n                10\n            )\n        )\n\n        // Axis\n        scene.add(\n            new THREE.AxesHelper(\n                5\n            )\n        )\n\n        // Cube with short command: geometry, material\n        const cube =\n            new THREE.Mesh(\n                new THREE.BoxGeometry(\n                    2,\n                    2,\n                    2\n                ),\n                new THREE.MeshStandardMaterial({\n                    color:0x00ff00\n                })\n\n            )\n        \n        // Set position only, not add into scene\n        cube.position.y = 0.5\n\n        // Cylinder: 0.5 = top radius, 0.5 = bottom radius, 2 = height, 32 = number of sides\n        const geometry =\n        new THREE.CylinderGeometry(\n            0.5,\n            0.5,\n            4,\n            32\n        )\n        \n        const material =\n        new THREE.MeshStandardMaterial({\n            color: 0x0300ff\n        })\n        \n        const cylinder =\n        new THREE.Mesh(\n            geometry,\n            material\n        )\n        \n        cylinder.position.y = 0.5\n\n        const groupUnit = new THREE.Group()\n        groupUnit.add(cube)\n        groupUnit.add(cylinder)\n\n        scene.add(groupUnit)\n        \n        const animate = () => {\n\n            requestAnimationFrame(\n                animate\n            )\n\n            controls.update()\n\n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
