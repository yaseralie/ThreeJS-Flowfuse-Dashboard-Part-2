        "format": "<template>\n    <div ref=\"container\" style=\"\n            width:100%;\n            height:100%;\n            min-height:400px;\n        \"></div>\n</template>\n\n<script>\nexport default {\n\n    async mounted() {\n\n        const THREE = await import(\n            'https://esm.sh/three@0.179.1'\n        )\n\n        const { OrbitControls } =\n            await import(\n                'https://esm.sh/three@0.179.1/examples/jsm/controls/OrbitControls'\n            )\n\n        const container =\n            this.$refs.container\n\n        const scene =\n            new THREE.Scene()\n\n        scene.background =\n            new THREE.Color(\n                0xf5f5f5\n            )\n\n        const camera =\n            new THREE.PerspectiveCamera(\n                75,\n                container.clientWidth /\n                container.clientHeight,\n                0.1,\n                1000\n            )\n\n        camera.position.set(\n            5,\n            5,\n            5\n        )\n\n        const renderer =\n            new THREE.WebGLRenderer({\n                antialias:true\n            })\n\n        renderer.setSize(\n            container.clientWidth,\n            container.clientHeight\n        )\n\n        container.appendChild(\n            renderer.domElement\n        )\n\n        // Orbit Controls\n        const controls =\n            new OrbitControls(\n                camera,\n                renderer.domElement\n            )\n\n        controls.enableDamping = true\n\n        // Light\n        scene.add(\n            new THREE.AmbientLight(\n                0xffffff,\n                1\n            )\n        )\n\n        const light =\n            new THREE.DirectionalLight(\n                0xffffff,\n                2\n            )\n\n        light.position.set(\n            5,\n            5,\n            5\n        )\n\n        scene.add(light)\n\n        // Grid\n        scene.add(\n            new THREE.GridHelper(\n                10,\n                10\n            )\n        )\n\n        // Axis\n        scene.add(\n            new THREE.AxesHelper(\n                5\n            )\n        )\n\n        // Cube\n        const cube =\n            new THREE.Mesh(\n\n                new THREE.BoxGeometry(\n                    1,\n                    1,\n                    1\n                ),\n\n                new THREE.MeshStandardMaterial({\n                    color:0x00ff00\n                })\n\n            )\n\n        cube.position.y = 0.5\n\n        scene.add(cube)\n\n        const animate = () => {\n\n            requestAnimationFrame(\n                animate\n            )\n\n            controls.update()\n\n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
