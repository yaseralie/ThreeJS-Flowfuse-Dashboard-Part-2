        "format": "<template>\n    <div\n        ref=\"container\"\n        style=\"\n            width:100%;\n            height:100%;\n            min-height:400px;\n        \"\n    ></div>\n</template>\n\n<script>\nexport default {\n\n    async mounted() {\n\n        const THREE = await import(\n            'https://esm.sh/three@0.179.1'\n        )\n\n        const { OrbitControls } =\n            await import(\n                'https://esm.sh/three@0.179.1/examples/jsm/controls/OrbitControls'\n            )\n\n        const container =\n            this.$refs.container\n\n        const scene =\n            new THREE.Scene()\n\n        scene.background =\n            new THREE.Color(\n                0xf5f5f5\n            )\n\n        const camera =\n            new THREE.PerspectiveCamera(\n                75,\n                container.clientWidth /\n                container.clientHeight,\n                0.1,\n                1000\n            )\n\n        camera.position.set(\n            5,\n            5,\n            5\n        )\n\n        const renderer =\n            new THREE.WebGLRenderer({\n                antialias:true\n            })\n\n        renderer.setSize(\n            container.clientWidth,\n            container.clientHeight\n        )\n\n        container.appendChild(\n            renderer.domElement\n        )\n\n        // Orbit Controls\n        const controls =\n            new OrbitControls(\n                camera,\n                renderer.domElement\n            )\n\n        controls.enableDamping = true\n\n        // Light\n        scene.add(\n            new THREE.AmbientLight(\n                0xffffff,\n                1\n            )\n        )\n\n        const light =\n            new THREE.DirectionalLight(\n                0xffffff,\n                2\n            )\n\n        light.position.set(\n            5,\n            5,\n            5\n        )\n\n        scene.add(light)\n\n        // Grid\n        scene.add(\n            new THREE.GridHelper(\n                10,\n                10\n            )\n        )\n\n        // Axis\n        scene.add(\n            new THREE.AxesHelper(\n                5\n            )\n        )\n\n        // Cube with short command: geometry, material\n        const cube =\n            new THREE.Mesh(\n                new THREE.BoxGeometry(\n                    2,\n                    2,\n                    2\n                ),\n                new THREE.MeshStandardMaterial({\n                    color:0x00ff00\n                })\n\n            )\n\n        // Add edges\n        const cubeEdges =\n            new THREE.LineSegments(\n                new THREE.EdgesGeometry(\n                cube.geometry\n                ),\n                new THREE.LineBasicMaterial({\n                color:0x000000\n                })\n            )\n        cube.add(cubeEdges)\n\n        // Set position only, not add into scene\n        cube.position.y = 0.5\n\n        // Cylinder: 0.5 = top radius, 0.5 = bottom radius, 2 = height, 32 = number of sides\n        const geometry =\n        new THREE.CylinderGeometry(\n            0.5,\n            0.5,\n            4,\n            32\n        )\n        \n        const material =\n        new THREE.MeshStandardMaterial({\n            color: 0x0300ff\n        })\n        \n        const cylinder =\n        new THREE.Mesh(\n            geometry,\n            material\n        )\n\n        // Add edges\n        const cylEdges =\n            new THREE.LineSegments(\n                new THREE.EdgesGeometry(\n                    cylinder.geometry\n                ),\n                new THREE.LineBasicMaterial({\n                    color:0x000000\n                })\n            )\n        cylinder.add(cylEdges)\n        cylinder.position.y = 0.5\n\n        const groupUnit = new THREE.Group()\n        groupUnit.add(cube)\n        groupUnit.add(cylinder)\n\n        const groupEdges = new THREE.LineSegments( \n            new THREE.EdgesGeometry(\n                groupUnit.geometry\n            ), \n            new THREE.LineBasicMaterial({\n            color:0x000000\n            })\n        )\n        \n        groupUnit.add(\n            groupEdges\n        )\n\n        scene.add(groupUnit)\n        \n        const animate = () => {\n\n            requestAnimationFrame(\n                animate\n            )\n\n            // Group animation\n            groupUnit.rotation.x += 0.01\n            groupUnit.rotation.y += 0.01\n\n            controls.update()\n\n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
